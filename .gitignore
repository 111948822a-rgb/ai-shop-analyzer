# =============================================================================
# AI Shop Analyzer —— 根 .gitignore（monorepo：backend + frontend）
# =============================================================================

# ---------------- 密钥 / 环境变量（绝不进版本库）----------------
.env
.env.*
!.env.example

# ---------------- Python（backend）----------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
*.db
*.sqlite3
uploads/

# ---------------- Node / Next.js（frontend）----------------
node_modules/
.next/
out/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------- 杂项 ----------------
.DS_Store
Thumbs.db
*.log
