# ===================== 基础配置 =====================
DATABASE_URL=sqlite:///./data/db.sqlite3
REDIS_URL=redis://localhost:6379/0
HOST=0.0.0.0
PORT=8000
REPORTS_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# ===================== AI（通义千问 / Dashscope）=====================
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_MODEL=Qwen3.7-MAX

# ===================== 飞书 =====================
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id
FEISHU_WEBHOOK_SECRET=
FEISHU_EVENT_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===================== 飞书秒搭 =====================
MIAODA_SECRET=your_miaoda_secret_here
MIAODA_API_URL=
MIAODA_API_KEY=
MIAODA_BITABLE_APP_TOKEN=
MIAODA_BITABLE_TABLE_ID=
MIAODA_USE_CELERY=false

# ===================== TikTok Shop Partner API =====================
# 服务商 App Key / App Secret（开放平台注册服务商后获得）
TK_PARTNER_APP_KEY=
TK_PARTNER_APP_SECRET=
# 已授权的店铺 ID（卖家在 TikTok 后台授权你的服务商应用后获得）
TK_AUTH_SHOP_ID=
# 首次授权拿到的 access_token / refresh_token（exchange_auth_code 后自动写回）
TK_AUTH_ACCESS_TOKEN=
TK_AUTH_REFRESH_TOKEN=
# Token 过期时间（ISO 格式，自动刷新时更新）
TK_TOKEN_EXPIRES_AT=

# ===================== Celery（可选）=====================
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ===================== 文件上传 =====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
